# --- Server ---
PORT=5000

# --- MongoDB Atlas ---
# Connection string for your MongoDB Atlas cluster
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=OpsMindAI

# --- Authentication ---
# Secret key for signing JWT tokens — use a strong random string in production
JWT_SECRET=your_super_secret_jwt_key_change_me

# --- Google Gemini ---
# API key for Google Gemini (embeddings + generation)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Tavily Web Search ---
# API key for Tavily web search (used for the "search" route and index fallback)
# Sign up for a free tier key at: https://tavily.com
# Free tier: 1,000 searches/month
TAVILY_API_KEY=your_tavily_api_key_here
